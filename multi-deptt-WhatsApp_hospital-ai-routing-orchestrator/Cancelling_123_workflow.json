      "parameters": {
        "jsCode": "// 1. Target the incoming data from the active item loop\nconst items = $json;\n\n// 2. Grab the text output sent from your AI Agent\nconst messageText = items.output || \"\";\n\n// 3. Fallback to your current state tracking routing type\nlet determinedType = items[\"Message Type\"] || \"audio\";\n\n// 4. Convert text to lowercase once for accurate string checking\nconst lowerText = messageText.toLowerCase();\n\n// 5. Check Rule A: Explicit Clinic Action JSON Intents (Kept as is)\nconst hasJsonIntent = lowerText.includes(\"booking confirmed\") || \n                      lowerText.includes(\"booking rescheduled\") || \n                      lowerText.includes(\"booking cancelled\");\n\n// 6. Check Rule B: Core Patient & Clinic Confirmation Headers\nconst hasSummaryLayout = lowerText.includes(\"patient name:\") || \n                         lowerText.includes(\"mobile number:\") || \n                         lowerText.includes(\"confirmation summary:\") ||\n                         lowerText.includes(\"shall i book?\");\n\n// 7. Check Rule C: Slot Availability Announcements\nconst hasSlotList = lowerText.includes(\"available slots:\") || \n                    lowerText.includes(\"slot on\") || \n                    lowerText.includes(\"is unavailable\");\n\n// 8. If any structured confirmation layout or slot list matches, force Text route\nif (hasJsonIntent || hasSummaryLayout || hasSlotList) {\n    determinedType = \"text\";\n}\n\n// 9. Output the clean object back to your downstream workflow nodes\nreturn {\n    \"output\": messageText,\n    \"Message Type\": determinedType,\n    \"Customer Number\": items[\"Customer Number\"] || \"\",\n    \"Session ID\": items[\"Session ID\"] || \"\",\n    \"Current_Department\": items[\"Current_Department\"] || \"Clinic Deptt\"\n};"
