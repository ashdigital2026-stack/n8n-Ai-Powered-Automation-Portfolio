      "parameters": {
        "jsCode": "// 1. Fetch raw text from the previous AI node\nconst inputItem = $input.item.json;\nlet rawText = inputItem.output || \"\";\n\n// Initialize routing flags and data maps\nlet parsedData = {};\nlet isIntentRoute = false;\n\n// Normalize line breaks and string spaces\nrawText = rawText.replace(/\\\\n/g, '\\n').replace(/\\\\r/g, '\\r').trim();\n\n// 2. MATRIX PARSING ENGINE: Intercept and validate JSON Block format\nif (rawText.includes('{') && rawText.includes('}')) {\n    try {\n        // Isolate the JSON string structure out of raw prose\n        const startJson = rawText.indexOf('{');\n        const endJson = rawText.lastIndexOf('}') + 1;\n        const jsonString = rawText.substring(startJson, endJson);\n        const cleanJson = JSON.parse(jsonString);\n        \n        // Normalize keys to lowercase to eliminate case mismatches\n        for (let key in cleanJson) {\n            parsedData[key.toLowerCase().replace(/[\\s_\\-]/g, '')] = String(cleanJson[key]);\n        }\n        \n        // Target Intent Verification: Check for cancellation structure\n        if (parsedData[\"intent\"] === \"booking cancelled\" || parsedData[\"intent\"] === \"cancelled\") {\n            isIntentRoute = true;\n        }\n    } catch (e) {\n        // Fall back to text line matching if JSON parsing fails due to syntax anomalies\n        parseTextByLines(rawText, parsedData);\n    }\n} else {\n    parseTextByLines(rawText, parsedData);\n}\n\n// Fallback line processing algorithm\nfunction parseTextByLines(text, dataObj) {\n    const lines = text.split(/[\\n\\r,]+/);\n    for (let line of lines) {\n        const colonIndex = line.indexOf(':');\n        if (colonIndex !== -1) {\n            let key = line.substring(0, colonIndex).replace(/[\\\\\"\\*\\{\\}]/g, '').trim().toLowerCase().replace(/[\\s_\\-]/g, '');\n            let value = line.substring(colonIndex + 1).replace(/[\\\\\"\\{\\}]/g, '').trim();\n            if (value.endsWith(',')) value = value.slice(0, -1).trim();\n            \n            if (key && value !== \"\" && !value.startsWith('[')) {\n                dataObj[key] = value;\n            }\n        }\n    }\n    if (dataObj[\"intent\"] === \"booking cancelled\" || dataObj[\"intent\"] === \"cancelled\") {\n        isIntentRoute = true;\n    }\n}\n\n// 3. DATA EXTRACTION LAYER\nconst intent = parsedData[\"intent\"] || (isIntentRoute ? \"booking cancelled\" : \"normal chat\");\nconst patientName = parsedData[\"patientname\"] || parsedData[\"patient name\"] || \"\";\nconst doctorName = parsedData[\"doctorname\"] || parsedData[\"doctor name\"] || \"\";\nconst department = parsedData[\"department\"] || \"\";\nconst calendarId = parsedData[\"calendarid\"] || parsedData[\"calendar id\"] || \"\";\nconst eventId = parsedData[\"eventid\"] || parsedData[\"event id\"] || null;\nconst rawDate = parsedData[\"date\"] || \"2026-05-28\";\n\n// Normalize Mobile Format (Strictly starting with 92, dropping leading 0)\nlet rawMobile = parsedData[\"mobile\"] || parsedData[\"mobilenumber\"] || \"\";\nlet cleanMobile = rawMobile.replace(/[^\\d]/g, '');\nif (cleanMobile.startsWith('0')) {\n    cleanMobile = '92' + cleanMobile.substring(1);\n} else if (!cleanMobile.startsWith('92') && cleanMobile.length > 0) {\n    cleanMobile = '92' + cleanMobile;\n}\n\n// 4. PACKAGING SYSTEM RESILIENT OUTBOUND PAYLOAD\nconst outputData = {\n    isIntent: isIntentRoute, // <--- Map your downstream IF Node strictly to this boolean variable\n    intent: intent,\n    patientName: patientName,\n    mobileNumber: cleanMobile,\n    department: department,\n    doctorName: doctorName,\n    date: rawDate,\n    calendarId: calendarId,\n    eventId: eventId,\n    conversationalReply: !isIntentRoute ? rawText : \"\" \n};\n\nreturn { json: outputData };"
      },
