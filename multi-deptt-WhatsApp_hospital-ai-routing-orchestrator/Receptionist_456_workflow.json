    {
      "parameters": {
        "jsCode": "// 1. Get the incoming data from the previous node\nconst inputItem = $input.item.json;\n\n// The input is a plain text string in the 'output' field\nconst rawOutput = inputItem.output || \"\";\n\nlet patientName = \"\";\nlet mobileNumber = \"\";\nlet testName = \"\";\nlet testCharges = \"\";\nlet routingDestination = \"\";\n\n// 2. Parse the plain text string\nif (rawOutput && typeof rawOutput === \"string\") {\n    // Replace literal \\n with actual newlines, then split\n    const lines = rawOutput.replace(/\\\\n/g, '\\n').split('\\n');\n    \n    for (let line of lines) {\n        line = line.trim();\n        \n        if (line.startsWith(\"Patient Name:\")) {\n            patientName = line.replace(\"Patient Name:\", \"\").trim();\n        }\n        else if (line.startsWith(\"Mobile Number:\")) {\n            mobileNumber = line.replace(\"Mobile Number:\", \"\").trim();\n        }\n        else if (line.startsWith(\"Test Name:\")) {\n            testName = line.replace(\"Test Name:\", \"\").trim();\n        }\n        else if (line.startsWith(\"Test Charges:\")) {\n            testCharges = line.replace(\"Test Charges:\", \"\").trim();\n        }\n        else if (line.startsWith(\"Routing Destination:\")) {\n            routingDestination = line.replace(\"Routing Destination:\", \"\").trim();\n        }\n    }\n}\n\n// 3. Convert mobile number to country code format (92XXXXXXXXXX)\nfunction formatToCountryCode(num) {\n    if (!num) return \"923005278470\";\n    \n    // Remove any non-digit characters\n    let digits = num.replace(/\\D/g, '');\n    \n    // If starts with 0 (local format like 03005278470), replace 0 with 92\n    if (digits.startsWith('0')) {\n        return '92' + digits.substring(1);\n    }\n    \n    // If already starts with 92, return as-is\n    if (digits.startsWith('92')) {\n        return digits;\n    }\n    \n    // If starts with 3 (without leading 0), prepend 92\n    if (digits.startsWith('3')) {\n        return '92' + digits;\n    }\n    \n    return digits;\n}\n\nconst formattedMobile = formatToCountryCode(mobileNumber);\n\n// 4. Generate the required Session ID format (MobileNumber-YYYYMMDD-HHmmss)\nconst formattedDateTime = $now.setZone('Asia/Karachi').toFormat('yyyyMMdd-HHmmss');\nconst generatedSessionId = `${formattedMobile}-${formattedDateTime}`;\n\n// 5. Initialize variables for routing\nlet destination = null;\n\n// 6. Use Routing Destination value if present\nif (routingDestination) {\n    destination = routingDestination;\n}\n\n// 7. Build the final clean output block\nconst outputData = {\n    routingDestination: destination,\n    patientName: patientName,\n    mobileNumber: formattedMobile,\n    testName: testName,\n    testCharges: testCharges,\n    sessionId: generatedSessionId\n};\n\nreturn { json: outputData };"
      },
